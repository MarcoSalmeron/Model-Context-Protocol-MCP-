OCI_CONFIG_PROFILE=DEFAULT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

MCP_TRANSPORT_MODE=stdio
ORACLE_MCP_HOST=127.0.0.1
ORACLE_MCP_PORT=8888
# Token OAuth/IDCS opcional para enviarlo como Bearer al endpoint HTTP.
ORACLE_MCP_BEARER_TOKEN=
# JSON opcional: una URL distinta por alias de servidor en modo HTTP.
# ORACLE_MCP_URLS={"compute":"http://127.0.0.1:8888/mcp","identity":"http://127.0.0.1:8889/mcp"}

LOG_LEVEL=INFO
LOG_FILE=logs/mcp_client.log
MCP_LOAD_ATTEMPTS=2
MCP_RETRY_DELAY_SECONDS=0.5
